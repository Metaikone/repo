function Get-ExistingIncidents {
    if (Test-Path $fichierHTML) {
        $htmlContent = Get-Content -Raw -Path $fichierHTML -Encoding UTF8
        $existingIncidents = @()

        # Vérification si le fichier contient bien des incidents
        if ($htmlContent -match "<tr><td>.+?</td><td>(.+?)</td></tr>") {
            $matches = [regex]::Matches($htmlContent, "<tr><td>.+?</td><td>(.+?)</td></tr>")
            foreach ($match in $matches) {
                $existingIncidents += $match.Groups[1].Value
            }
        }
        return $existingIncidents
    }
    return @()
}
