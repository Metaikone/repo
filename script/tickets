Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# Définition du fichier HTML
$fichierHTML = "D:\historique_incidents.html"

# Définition de l'URL et de la position de $incident
$urlTemplate = "http://search/{incident}/result"
$linkTemplate = "<a href='{url}' target='_blank'>{incident}</a>"

# Vérifier si le fichier HTML existe, sinon le créer avec un squelette de base
if (!(Test-Path $fichierHTML)) {
    @"
<!DOCTYPE html>
<html lang='fr'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Historique des incidents</title>
    <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css'>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #121212;
            color: #E0E0E0;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 0;
            padding: 20px;
        }
        h2 {
            color: #0078D7;
            margin-bottom: 20px;
        }
        .filter-section {
            width: 100%;
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .filter-buttons {
            display: flex;
            gap: 10px;
        }
        .filter-buttons button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background: #333;
            color: white;
            transition: 0.3s;
        }
        .filter-buttons button.active {
            background: #0078D7;
        }
        input {
            padding: 10px;
            width: 250px;
            border-radius: 5px;
            border: 1px solid #444;
            background: #1E1E1E;
            color: white;
            text-align: center;
        }
        table {
            width: 90%;
            border-collapse: collapse;
            margin: 20px 0;
            background: #1E1E1E;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            border-radius: 5px;
            overflow: hidden;
        }
        th, td {
            padding: 12px 15px;
            border-bottom: 1px solid #444;
            text-align: left;
        }
        th {
            background: #0078D7;
            color: white;
        }
        tr:nth-child(even) {
            background: #2C2C2C;
        }
        tr:hover {
            background: #3C3C3C;
        }
        .refresh-button {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #0078D7;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            cursor: pointer;
        }
        p {
            font-size: 14px;
            margin-top: 10px;
        }
        a {
            color: #00BFFF; /* Light Blue */
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .calendar {
            margin-bottom: 20px;
        }
    </style>
    <script src='https://cdn.jsdelivr.net/npm/flatpickr'></script>
    <script>
        function updateIncidentCount() {
            var table = document.getElementById('logTable');
            var tr = table.getElementsByTagName('tr');
            var count = 0;
            for (var i = 1; i < tr.length; i++) {
                if (tr[i].style.display !== 'none') {
                    count++;
                }
            }
            document.getElementById('incidentCount').textContent = 'Nombre d\'incidents affichés : ' + count;
        }

        function filterTableByDate(range) {
            var table = document.getElementById('logTable');
            var tr = table.getElementsByTagName('tr');
            var now = new Date();
            for (var i = 1; i < tr.length; i++) {
                var td = tr[i].getElementsByTagName('td')[0];
                if (td) {
                    var incidentDate = new Date(td.textContent);
                    var display = false;
                    switch (range) {
                        case 'today': display = (incidentDate.toDateString() === now.toDateString()); break;
                        case 'week': 
                            var oneWeekAgo = new Date(); 
                            oneWeekAgo.setDate(now.getDate() - 7);
                            display = (incidentDate >= oneWeekAgo && incidentDate <= now); 
                            break;
                        case 'month': 
                            var oneMonthAgo = new Date(); 
                            oneMonthAgo.setMonth(now.getMonth() - 1);
                            display = (incidentDate >= oneMonthAgo && incidentDate <= now); 
                            break;
                        case 'all': display = true; break;
                    }
                    tr[i].style.display = display ? '' : 'none';
                }
            }
            updateIncidentCount();
            setActiveButton('date', range);
        }

        function filterTableByExactDateRange(startDate, endDate) {
            var table = document.getElementById('logTable');
            var tr = table.getElementsByTagName('tr');
            var start = new Date(startDate);
            var end = new Date(endDate);
            for (var i = 1; i < tr.length; i++) {
                var td = tr[i].getElementsByTagName('td')[0];
                if (td) {
                    var incidentDate = new Date(td.textContent);
                    var display = (incidentDate >= start && incidentDate <= end);
                    tr[i].style.display = display ? '' : 'none';
                }
            }
            updateIncidentCount();
        }

        function filterTableByName() {
            var inputText = document.getElementById('filterText').value.toLowerCase();
            var table = document.getElementById('logTable');
            var tr = table.getElementsByTagName('tr');
            for (var i = 1; i < tr.length; i++) {
                var td = tr[i].getElementsByTagName('td')[1];
                if (td) {
                    tr[i].style.display = td.textContent.toLowerCase().includes(inputText) ? '' : 'none';
                }
            }
            updateIncidentCount();
        }

        function filterTableByType(type) {
            var table = document.getElementById('logTable');
            var tr = table.getElementsByTagName('tr');
            for (var i = 1; i < tr.length; i++) {
                var td = tr[i].getElementsByTagName('td')[1];
                if (td) {
                    var isIncident = td.textContent.includes('INC');
                    var display = false;
                    switch (type) {
                        case 'incident': display = isIncident; break;
                        case 'ritm': display = !isIncident; break;
                        case 'all': display = true; break;
                    }
                    tr[i].style.display = display ? '' : 'none';
                }
            }
            updateIncidentCount();
            setActiveButton('type', type);
        }

        function setActiveButton(category, value) {
            var buttons = document.querySelectorAll('.filter-buttons button[data-' + category + ']');
            buttons.forEach(function(button) {
                if (button.getAttribute('data-' + category) === value) {
                    button.classList.add('active');
                } else {
                    button.classList.remove('active');
                }
            });
        }

        function refreshPage() {
            location.reload();
        }

        window.onload = function() {
            filterTableByDate('all');
            filterTableByType('all');
            setInterval(refreshPage, 30000);
            flatpickr('#calendar', {
                mode: 'range',
                onChange: function(selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        filterTableByExactDateRange(selectedDates[0], selectedDates[1]);
                    }
                }
            });
        }
    </script>
</head>
<body>
    <h2>Historique des incidents</h2>
    <div class="filter-section">
        <div class="filter-buttons">
            <button data-date="today" onclick="filterTableByDate('today')">Aujourd'hui</button>
            <button data-date="week" onclick="filterTableByDate('week')">7 Jours</button>
            <button data-date="month" onclick="filterTableByDate('month')">1 Mois</button>
            <button data-date="all" class="active" onclick="filterTableByDate('all')">Tout</button>
        </div>
        <div class="filter-buttons">
            <button data-type="incident" onclick="filterTableByType('incident')">Incidents</button>
            <button data-type="ritm" onclick="filterTableByType('ritm')">RITMs</button>
            <button data-type="all" class="active" onclick="filterTableByType('all')">Tous</button>
        </div>
    </div>
    <div class="calendar">
        <input type="text" id="calendar" placeholder="Sélectionner une période">
    </div>
    <input type="text" id="filterText" placeholder="Rechercher un incident..." oninput="filterTableByName()">
    <button class="refresh-button" onclick="refreshPage()">Rafraîchir</button>
    <p id="incidentCount">Nombre d'incidents affichés : 0</p>
    <table id="logTable">
        <thead>
            <tr><th>Horodatage</th><th>Incident</th></tr>
        </thead>
        <tbody id="logEntries"></tbody>
    </table>
</body>
</html>
"@ | Out-File -Encoding UTF8 -FilePath $fichierHTML
}

# Fonction pour récupérer les incidents déjà présents dans le fichier HTML
function Get-ExistingIncidents {
    param (
        [string]$fichierHTML
    )

    if (Test-Path $fichierHTML) {
        $htmlContent = Get-Content -Raw -Path $fichierHTML -Encoding UTF8
        $existingIncidents = @()

        # Vérification pour récupérer tous les incidents
        $matches = [regex]::Matches($htmlContent, "<a href=.+?>(.+?)</a>")
        foreach ($match in $matches) {
            $existingIncidents += $match.Groups[1].Value
        }

        return $existingIncidents
    }
    return @()
}

# Fonction pour ajouter un incident unique dans le fichier HTML
function AjouterIncidentHTML {
    param (
        [string]$incident,
        [string]$fichierHTML,
        [string]$urlTemplate,
        [string]$linkTemplate
    )

    $incident = $incident.Trim()
    if ($incident -eq "") { return }

    # Générer l'URL et le lien hypertexte pour l'incident
    $url = $urlTemplate -replace "{incident}", $incident
    $incidentLink = $linkTemplate -replace "{url}", $url -replace "{incident}", $incident

    # Vérifier si l'incident existe déjà dans le fichier HTML
    $existingIncidents = Get-ExistingIncidents -fichierHTML $fichierHTML
    if ($existingIncidents -contains $incident) {
        [System.Windows.Forms.MessageBox]::Show("Cet incident existe déjà.", "Doublon détecté", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning)
        return
    }

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    # Lire le contenu actuel du fichier HTML
    $htmlContent = Get-Content -Raw -Path $fichierHTML
    $nouvelleLigne = "<tr><td>$timestamp</td><td>$incidentLink</td></tr>"

    # Injecter la nouvelle ligne en haut du tableau
    $htmlContent = $htmlContent -replace "(<tbody id=`"logEntries`">)", "`$1`n$nouvelleLigne"
    $htmlContent | Out-File -Encoding UTF8 -FilePath $fichierHTML
}

# Fonction pour importer un fichier d'incidents
function ImporterFichierIncidents {
    param (
        [string]$fichierHTML,
        [string]$urlTemplate,
        [string]$linkTemplate
    )

    $openFileDialog = New-Object System.Windows.Forms.OpenFileDialog
    $openFileDialog.InitialDirectory = "D:\"
    $openFileDialog.Filter = "Fichiers texte (*.txt)|*.txt|Tous les fichiers (*.*)|*.*"
    $openFileDialog.Title = "Sélectionner un fichier d'incidents"

    if ($openFileDialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $fichierImport = $openFileDialog.FileName
        if (Test-Path $fichierImport) {
            $existingIncidents = Get-ExistingIncidents -fichierHTML $fichierHTML
            $incidents = Get-Content -Path $fichierImport | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne "" }

            $incidentsAjoutes = 0
            foreach ($incident in $incidents) {
                # Vérification des doublons avant l'ajout
                if ($existingIncidents -notcontains $incident) {
                    AjouterIncidentHTML -incident $incident -fichierHTML $fichierHTML -urlTemplate $urlTemplate -linkTemplate $linkTemplate
                    $incidentsAjoutes++
                }
            }
            
            if ($incidentsAjoutes -eq 0) {
                [System.Windows.Forms.MessageBox]::Show("Aucun nouvel incident ajouté.", "Aucune nouveauté", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
            }
        }
    }
}

# Interface Graphique avec 3 boutons
$form = New-Object System.Windows.Forms.Form
$form.Text = "Ajout d'un incident"
$form.Size = New-Object System.Drawing.Size(420, 200)
$form.StartPosition = "CenterScreen"

$label = New-Object System.Windows.Forms.Label
$label.Text = "Décrivez l'incident :"
$label.Location = New-Object System.Drawing.Point(20, 20)
$label.Size = New-Object System.Drawing.Size(200, 20)
$form.Controls.Add($label)

$textbox = New-Object System.Windows.Forms.TextBox
$textbox.Location = New-Object System.Drawing.Point(20, 50)
$textbox.Size = New-Object System.Drawing.Size(350, 20)
$form.Controls.Add($textbox)

# Bouton "OK"
$btnOK = New-Object System.Windows.Forms.Button
$btnOK.Text = "OK"
$btnOK.Location = New-Object System.Drawing.Point(50, 100)
$btnOK.Add_Click({
    AjouterIncidentHTML -incident $textbox.Text -fichierHTML $fichierHTML -urlTemplate $urlTemplate -linkTemplate $linkTemplate
    $textbox.Text = ""  # Vider la boîte après ajout
})
$form.Controls.Add($btnOK)

# Bouton "Importer un fichier"
$btnImport = New-Object System.Windows.Forms.Button
$btnImport.Text = "Importer un fichier"
$btnImport.Location = New-Object System.Drawing.Point(160, 100)
$btnImport.Add_Click({
    ImporterFichierIncidents -fichierHTML $fichierHTML -urlTemplate $urlTemplate -linkTemplate $linkTemplate
})
$form.Controls.Add($btnImport)

# Bouton "Annuler"
$btnAnnuler = New-Object System.Windows.Forms.Button
$btnAnnuler.Text = "Annuler"
$btnAnnuler.Location = New-Object System.Drawing.Point(280, 100)
$btnAnnuler.Add_Click({ $form.Close() })
$form.Controls.Add($btnAnnuler)

# Lancer la fenêtre
$form.ShowDialog()
